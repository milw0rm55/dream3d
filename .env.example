# Copia este archivo como .env (en la misma carpeta que server.js) y rellena los valores.
# El archivo .env tiene contraseñas: no lo compartas ni lo subas a ningún repositorio.

# Correo que recibe los mensajes del formulario de contacto
CONTACT_TO=tu-correo@ejemplo.com

# Servidor de correo de salida (SMTP)
# Ejemplo con Gmail: hace falta una "contraseña de aplicación"
# (Cuenta de Google → Seguridad → Verificación en dos pasos → Contraseñas de aplicaciones)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=cuenta-que-envia@gmail.com
SMTP_PASS=contraseña-de-aplicacion
SMTP_FROM="forma3d <cuenta-que-envia@gmail.com>"

# Contraseña del panel de administración (obligatoria en producción)
ADMIN_PASS=

# Pagos con tarjeta, Apple Pay y Google Pay (Stripe → Desarrolladores → Claves de API).
# Empieza con las claves de prueba (sk_test_...) y cámbialas por las reales (sk_live_...) al publicar.
STRIPE_SECRET_KEY=
# Stripe → Desarrolladores → Webhooks → añadir endpoint https://dream3d.es/api/stripe/webhook
# con los eventos checkout.session.completed y checkout.session.async_payment_succeeded; copia aquí su "Signing secret".
STRIPE_WEBHOOK_SECRET=
